# ---- LLM provider (choose ONE) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider to use for generation: "anthropic" | "openai"
STEUER_RAG_LLM_PROVIDER=anthropic
STEUER_RAG_LLM_MODEL=claude-opus-4-7

# ---- Embedding model (multilingual) ----
# Default: BAAI/bge-m3 (1024-d, supports DE+EN+100 langs, dense+sparse+colbert)
STEUER_RAG_EMBED_MODEL=BAAI/bge-m3
STEUER_RAG_EMBED_DEVICE=cpu          # cpu | cuda | mps

# ---- Reranker (multilingual cross-encoder) ----
STEUER_RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
STEUER_RAG_RERANK_TOP_N=50

# ---- Vector store ----
STEUER_RAG_VECTOR_BACKEND=chroma     # chroma
STEUER_RAG_CHROMA_DIR=./data/chroma
STEUER_RAG_COLLECTION=steuer_chunks

# ---- Scraper ----
STEUER_RAG_USER_AGENT=steuer-rag/0.1 (+contact: you@example.com)
STEUER_RAG_REQUEST_DELAY_MS=400
STEUER_RAG_MAX_CONCURRENCY=4
STEUER_RAG_RAW_DIR=./data/raw

# ---- Chunking ----
STEUER_RAG_CHUNK_SIZE=1200
STEUER_RAG_CHUNK_OVERLAP=200
STEUER_RAG_MIN_CHUNK_CHARS=200

# ---- Retrieval defaults ----
STEUER_RAG_TOP_K=8
STEUER_RAG_HYBRID_DENSE_WEIGHT=0.6
STEUER_RAG_HYBRID_SPARSE_WEIGHT=0.4

# ---- Logging ----
STEUER_RAG_LOG_LEVEL=INFO