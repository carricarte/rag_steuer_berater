#!/usr/bin/env bash
# Pre-commit guard against accidental secret leaks.
#
# Blocks the commit when:
#   1. A staged file is a *.env / secrets.* / *.pem / *.key (except .env.example).
#   2. Staged content matches a known secret prefix or high-entropy assignment.
#
# Bypass once with `git commit --no-verify`. Don't make that a habit.
set -euo pipefail

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
yellow(){ printf '\033[33m%s\033[0m\n' "$*"; }

# 1) Block dangerous filenames
banned_files=$(
  git diff --cached --name-only --diff-filter=ACM \
    | grep -E '(^|/)(\.env(\..+)?|secrets\.toml|.*\.secret|.*\.secrets\..*|credentials\.json|service-account.*\.json|.*\.pem|.*\.key)$' \
    | grep -vE '(^|/)\.env\.example$' || true
)
if [[ -n "$banned_files" ]]; then
  red "pre-commit: refusing to commit secret-bearing files:"
  printf '  - %s\n' $banned_files
  yellow "If this is intentional, remove the file from git or rename it. To override (not recommended): git commit --no-verify"
  exit 1
fi

# 2) Scan staged content for known secret patterns
# Patterns chosen to be tight enough to avoid false positives on docs.
patterns=(
  'sk-ant-api03-[A-Za-z0-9_\-]{20,}'   # Anthropic
  'sk-proj-[A-Za-z0-9_\-]{20,}'        # OpenAI project key
  'sk-svcacct-[A-Za-z0-9_\-]{20,}'     # OpenAI service-account key
  'sk-[A-Za-z0-9]{32,}'                # generic OpenAI / Stripe-style
  'ghp_[A-Za-z0-9]{30,}'               # GitHub personal token
  'ghs_[A-Za-z0-9]{30,}'               # GitHub server token
  'AKIA[0-9A-Z]{16}'                   # AWS access-key id
  'AIza[0-9A-Za-z\-_]{30,}'            # Google API key
  'xox[abprs]-[A-Za-z0-9-]{10,}'       # Slack tokens
  '-----BEGIN [A-Z ]*PRIVATE KEY-----' # PEM private keys
)

# Build one extended regex
joined=$(IFS='|'; echo "${patterns[*]}")

hits=$(
  git diff --cached -U0 --no-color --diff-filter=ACM \
    | grep -E '^\+' \
    | grep -vE '^\+\+\+' \
    | grep -nE "$joined" || true
)

if [[ -n "$hits" ]]; then
  red "pre-commit: staged change contains a potential secret:"
  printf '%s\n' "$hits"
  yellow "Remove the secret (or move it to .env, which is gitignored). Bypass with --no-verify only if certain."
  exit 1
fi

exit 0
